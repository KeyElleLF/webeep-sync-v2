  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window only. The login window (remote WeBeep pages) gets no capability.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
